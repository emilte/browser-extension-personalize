{
    // https://biomejs.dev/reference/configuration/
    "$schema": "https://biomejs.dev/schemas/2.4.11/schema.json",
    "files": {
        "includes": [
            "**/*.js",
            "**/*.jsx",
            "**/*.ts",
            "**/*.tsx",
            "**/*.css",
            "**/*.scss"
        ]
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "lineWidth": 120
        }
    }
}